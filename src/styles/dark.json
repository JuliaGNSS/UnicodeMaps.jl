{
  "name": "unicodemaps-dark",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#0e1116" }
    },
    {
      "id": "water",
      "type": "fill",
      "source-layer": "water",
      "paint": { "fill-color": "#20506e" }
    },
    {
      "id": "landcover-wood",
      "type": "fill",
      "source-layer": "landcover",
      "filter": ["in", "class", "wood", "forest"],
      "paint": { "fill-color": "#1c3d29" }
    },
    {
      "id": "landcover-grass",
      "type": "fill",
      "source-layer": "landcover",
      "filter": ["in", "class", "grass", "park", "meadow"],
      "paint": { "fill-color": "#254a32" }
    },
    {
      "id": "landcover-ice",
      "type": "fill",
      "source-layer": "landcover",
      "filter": ["in", "class", "ice", "glacier", "snow"],
      "paint": { "fill-color": "#3a4d63" }
    },
    {
      "id": "landcover-sand",
      "type": "fill",
      "source-layer": "landcover",
      "filter": ["in", "class", "sand", "beach"],
      "paint": { "fill-color": "#4a4128" }
    },
    {
      "id": "landuse-residential",
      "type": "fill",
      "source-layer": "landuse",
      "minzoom": 8,
      "filter": ["in", "class", "residential", "suburb", "neighbourhood"],
      "paint": { "fill-color": "#191d25" }
    },
    {
      "id": "building",
      "type": "fill",
      "source-layer": "building",
      "minzoom": 13,
      "paint": { "fill-color": "#4b5468" }
    },
    {
      "id": "road-minor",
      "type": "line",
      "source-layer": "transportation",
      "minzoom": 12,
      "filter": ["in", "class", "minor", "service", "track", "path", "pedestrian"],
      "paint": { "line-color": "#8b909c", "line-width": 1 }
    },
    {
      "id": "road-secondary",
      "type": "line",
      "source-layer": "transportation",
      "minzoom": 9,
      "filter": ["in", "class", "secondary", "tertiary"],
      "paint": { "line-color": "#d7b46a", "line-width": 1 }
    },
    {
      "id": "road-major",
      "type": "line",
      "source-layer": "transportation",
      "minzoom": 5,
      "filter": ["in", "class", "motorway", "trunk", "primary"],
      "paint": { "line-color": "#ffcf6b", "line-width": 2 }
    },
    {
      "id": "railway",
      "type": "line",
      "source-layer": "transportation",
      "minzoom": 11,
      "filter": ["==", "class", "rail"],
      "paint": { "line-color": "#767676", "line-width": 1 }
    },
    {
      "id": "boundary-country",
      "type": "line",
      "source-layer": "boundary",
      "filter": ["<=", "admin_level", 2],
      "paint": { "line-color": "#c6ccda", "line-width": 1 }
    },
    {
      "id": "boundary-state",
      "type": "line",
      "source-layer": "boundary",
      "minzoom": 4,
      "filter": ["all", [">", "admin_level", 2], ["<=", "admin_level", 4]],
      "paint": { "line-color": "#727892", "line-width": 1 }
    },
    {
      "id": "place-country",
      "type": "symbol",
      "source-layer": "place",
      "filter": ["in", "class", "country", "continent"],
      "paint": { "text-color": "#e7d69c" }
    },
    {
      "id": "place-city",
      "type": "symbol",
      "source-layer": "place",
      "minzoom": 4,
      "filter": ["in", "class", "city", "town"],
      "paint": { "text-color": "#ffffff" }
    },
    {
      "id": "place-other",
      "type": "symbol",
      "source-layer": "place",
      "minzoom": 8,
      "filter": ["in", "class", "village", "hamlet", "suburb", "neighbourhood"],
      "paint": { "text-color": "#aab2c4" }
    },
    {
      "id": "water-name",
      "type": "symbol",
      "source-layer": "water_name",
      "paint": { "text-color": "#79b2e8" }
    }
  ]
}
